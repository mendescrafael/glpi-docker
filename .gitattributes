# -----------------------------------------------------------------------------
# Normalização de arquivos de texto.
# -----------------------------------------------------------------------------
* text=auto eol=lf

# Scripts executados nativamente no Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Arquivos de texto usados pelo projeto.
*.md           text eol=lf diff=markdown
*.yml          text eol=lf
*.yaml         text eol=lf
*.env          text eol=lf
*.example      text eol=lf
*.template     text eol=lf
*.conf         text eol=lf
*.sh           text eol=lf
*.php          text eol=lf diff=php
Dockerfile     text eol=lf
Makefile       text eol=lf
app-entrypoint text eol=lf

# -----------------------------------------------------------------------------
# Arquivos binários.
# -----------------------------------------------------------------------------
*.7z     binary
*.base64 binary
*.eot    binary
*.exe    binary
*.gif    binary
*.gz     binary
*.icc    binary
*.ico    binary
*.jpeg   binary
*.jpg    binary
*.mo     binary
*.mp3    binary
*.ogg    binary
*.otf    binary
*.pdf    binary
*.png    binary
*.sig    binary
*.tar    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
*.xlsx   binary
*.z      binary
*.zip    binary

# -----------------------------------------------------------------------------
# Classificação de dependências e arquivos gerados no GitHub Linguist.
# -----------------------------------------------------------------------------
app/vendor/**              -text linguist-vendored=true
app/public/lib/**          linguist-vendored=true
app/public/build/**        linguist-generated=true
app/public/css_compiled/** linguist-generated=true
*.min.css                  linguist-generated=true
*.min.js                   linguist-generated=true
*.map                      linguist-generated=true
